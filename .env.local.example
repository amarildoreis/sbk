NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Nome de exibição da conta de fallback (ex: em e-mails enviados por ela). Opcional — sem isso, cai em "Administrador".
ADMIN_NAME=

# SQL Server (FACTORING) — instância operada pela WBA (CLAUDE.md seção 1.1).
# Login OBRIGATORIAMENTE somente-leitura (db_datareader). Nunca commitar valores reais.
DB_HOST=
DB_PORT=1433
DB_NAME=FACTORING
DB_USER=
DB_PASSWORD=
# Padrão recomendado é true. Só use false se o servidor não tiver TLS
# configurado (validado neste projeto para 10.0.0.213 — servidor legado sem
# certificado, em rede interna confiável) e após confirmação explícita.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
# Opcional — só defina se a conexão falhar com erro de negociação TLS
# ("unsupported protocol") mas o servidor ainda suportar alguma versão de
# TLS. Comece por TLSv1.2; só desça para TLSv1.1/TLSv1 com confirmação
# explícita, pois é uma concessão de segurança real.
# DB_TLS_MIN_VERSION=TLSv1.2

# MySQL — banco próprio da plataforma (dados gerados aqui, leitura E escrita).
# Preencha com o MESMO valor em .env (o Prisma CLI lê de lá, a aplicação lê daqui).
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=

# SMTP — envio do e-mail de boas-vindas ao criar usuário. Se deixar em
# branco, a aplicação só loga um aviso e segue sem enviar (não quebra o
# cadastro). Preencha quando tiver as credenciais do provedor de e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SBK Capital <no-reply@sbkcapital.com.br>"

# Interação por IA (RAG, CLAUDE.md seção 12) — chave da API da Anthropic,
# criada em console.anthropic.com (Settings → API Keys). Usada pelo
# classificador de intenção (Tool Use) e pela síntese de resposta. Sem isso,
# o módulo de IA não funciona; nenhum outro módulo da plataforma depende dela.
ANTHROPIC_API_KEY=
